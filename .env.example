# Copy to .env and fill in. .env is gitignored — never commit real values.

# Your Airbnb listing's iCal export URL (Airbnb → listing → Availability → export calendar).
# Treat this like a password: anyone with it can see your booking dates.
AIRBNB_ICAL_URL=

