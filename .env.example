# Copy to .env and fill in. .env is gitignored — never commit real values.

# Your Airbnb listing's iCal export URL (Airbnb → listing → Availability → export calendar).
# Treat this like a password: anyone with it can see your booking dates.
AIRBNB_ICAL_URL=

# Supabase (added in Slice 2)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Service-role (secret) key — REQUIRED for the sync once RLS is enabled
# (db/003_auth_rls.sql). The sync runs server-side and bypasses RLS with this.
# Treat it like a root password: NEVER expose it to the browser / commit it.
# SUPABASE_SECRET_KEY=

# Live Gmail ingestion for `npm run names -- --gmail` (auto guest names).
# IMAP + a Gmail APP PASSWORD (Google Account → Security → 2-Step Verification →
# App passwords). Needs IMAP enabled in Gmail settings. See README → "Live Gmail
# ingestion". Without these, `npm run names` still works against a local email
# folder / the bundled samples.
# GMAIL_USER=              # mailbox address, e.g. coopertenney7@gmail.com
# GMAIL_APP_PASSWORD=      # 16-char app password (spaces are fine)
# GMAIL_FROM=airbnb        # optional — sender substring to match (default: airbnb)
# GMAIL_LOOKBACK_DAYS=30   # optional — how many days back to search (default: 30)
