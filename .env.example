# Copy to .env and fill in. .env is gitignored — never commit real values.

# Your Airbnb listing's iCal export URL (Airbnb → listing → Availability → export calendar).
# Treat this like a password: anyone with it can see your booking dates.
AIRBNB_ICAL_URL=

# Supabase (added in Slice 2)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Service-role (secret) key — REQUIRED for the sync once RLS is enabled
# (db/003_auth_rls.sql). The sync runs server-side and bypasses RLS with this.
# Treat it like a root password: NEVER expose it to the browser / commit it.
# SUPABASE_SECRET_KEY=

# Live Gmail ingestion for `npm run names -- --gmail` (auto guest names).
# From a Google Cloud OAuth "Desktop app" client the operator consents to once,
# scope https://www.googleapis.com/auth/gmail.readonly. See README → "Live Gmail
# ingestion" for how to obtain the refresh token. Without these, `npm run names`
# still works against a local email folder / the bundled samples.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_QUERY=   # optional — override the default Airbnb search query
